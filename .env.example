# ─────────────────────────────────────────────────────────────────────────────
# Advantix Agency — Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env:
#   cp .env.example .env
# Then fill in your values.
# ─────────────────────────────────────────────────────────────────────────────

# ── Required ──────────────────────────────────────────────────────────────────

# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/advantix

# Session encryption secret — generate with: openssl rand -hex 32
SESSION_SECRET=change-this-to-a-long-random-string

# Port the API server listens on
PORT=8080

# Node environment
NODE_ENV=production

# ── Admin credentials ─────────────────────────────────────────────────────────
# These are used on FIRST RUN to create the admin account.
# Change them before deploying for the first time.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=2816

# ── AI Providers (at least one required for Advantix AI) ─────────────────────
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GOOGLE_AI_API_KEY=...

# ── Optional: Telegram notifications ─────────────────────────────────────────
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
