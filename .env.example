# ─────────────────────────────────────────────────────────────────────────────
# Advantix Digital — Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file and fill in your values before deploying:
#   cp .env.example .env
#
# On DigitalOcean App Platform, set these in:
#   App → Settings → Environment Variables
# ─────────────────────────────────────────────────────────────────────────────


# ── Required ──────────────────────────────────────────────────────────────────

# PostgreSQL connection string (DigitalOcean managed DB → Connection Details)
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Session encryption secret — MUST be set or all sessions invalidate on restart
# Generate with:  openssl rand -hex 32
SESSION_SECRET=replace-with-64-hex-chars

# Server port — DigitalOcean App Platform sets this automatically
PORT=8080

# Node environment — MUST be "production" in production
NODE_ENV=production


# ── Site identity ─────────────────────────────────────────────────────────────

# Your public domain — used for OG meta tags and SSO redirect URLs
SITE_URL=https://advantix.digital

# Comma-separated list of allowed CORS origins (your domain + any subdomains)
# Leave empty to allow same-origin only (recommended)
ALLOWED_ORIGINS=https://advantix.digital


# ── Admin credentials ─────────────────────────────────────────────────────────
# Synced to the database on every server startup — safe to change and redeploy.
# The first account created is automatically a Super Admin.

ADMIN_USERNAME=admin
ADMIN_PASSWORD=2816


# ── AI Providers ──────────────────────────────────────────────────────────────
# At least one key is required for the Advantix AI tools to work.

# OpenAI (GPT-4o, DALL-E image generation)
OPENAI_API_KEY=sk-...

# Anthropic (Claude)
ANTHROPIC_API_KEY=sk-ant-...

# Google Gemini
GOOGLE_AI_API_KEY=AIza...


# ── Email sending (Resend) ────────────────────────────────────────────────────
# Required for the Email Marketing module and contact form email replies.
# Sign up at https://resend.com — free tier allows 3,000 emails/month.

# RESEND_API_KEY=re_...


# ── Push notifications (Web Push / VAPID) ────────────────────────────────────
# Required for browser push notification subscriptions.
# Generate with:  npx web-push generate-vapid-keys

# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=


# ── Telegram notifications ────────────────────────────────────────────────────
# Optional — sends new lead / contact form alerts to a Telegram chat.
# Create a bot via @BotFather, then get the chat ID from @userinfobot.

# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=


# ── Google OAuth (optional) ───────────────────────────────────────────────────
# Enables "Sign in with Google" for tool users.
# Create credentials at https://console.cloud.google.com/apis/credentials

# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=


# ── Cloudflare Turnstile (optional) ──────────────────────────────────────────
# Bot protection on contact forms. Get keys at https://dash.cloudflare.com

# CF_TURNSTILE_SECRET_KEY=


# ── Object / file storage (optional) ─────────────────────────────────────────
# Used by the gallery and file storage features.
# Leave unset to use local disk storage under /app/uploads/

# PRIVATE_OBJECT_DIR=/data/private
# PUBLIC_OBJECT_SEARCH_PATHS=/app/uploads


# ── Logging ───────────────────────────────────────────────────────────────────
# Pino log level: trace | debug | info | warn | error | fatal
# Default: info

# LOG_LEVEL=info
