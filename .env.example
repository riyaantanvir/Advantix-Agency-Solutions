# ─────────────────────────────────────────────────────────────────────────────
# Advantix Agency — Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env for local development:
#   cp .env.example .env
#
# On DigitalOcean, set these in the App Platform dashboard.
# DATABASE_URL and PORT are injected automatically by DigitalOcean.
# ─────────────────────────────────────────────────────────────────────────────

# ── Required ──────────────────────────────────────────────────────────────────

# PostgreSQL connection string
# DigitalOcean injects this automatically from the managed database.
# For local dev, use your own Postgres instance:
DATABASE_URL=postgresql://user:password@localhost:5432/advantix

# Session encryption secret — generate with: openssl rand -hex 32
SESSION_SECRET=change-this-to-a-long-random-string

# Port the server listens on
PORT=8080

# ── Optional ──────────────────────────────────────────────────────────────────

# Node environment: development | production
NODE_ENV=production

# Comma-separated list of allowed CORS origins (production only).
# Leave empty to allow same-origin only (recommended).
# ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ─────────────────────────────────────────────────────────────────────────────
# Admin credentials (set once via seed.ts — do NOT change after first deploy)
# ─────────────────────────────────────────────────────────────────────────────
# Username : admin
# Password : 2816
# ─────────────────────────────────────────────────────────────────────────────
